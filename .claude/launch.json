{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "youthdb",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "3111"
      ],
      "port": 3111
    },
    {
      "name": "youthdb-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:demo",
        "--port",
        "3112"
      ],
      "port": 3112
    },
    {
      "name": "youthdb-pilot",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=",
        "YOUTHDB_PGDATA=.pgdata-pilot",
        "YOUTHDB_PASSWORD=pilot-all",
        "YOUTHDB_PASSWORD_PERSONAL=pilot-hirashain",
        "YOUTHDB_SESSION_SECRET=pilot-only-not-a-real-secret",
        "pnpm",
        "dev",
        "--port",
        "3113"
      ],
      "port": 3113
    }
  ]
}