{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*)",
      "Read(../YouthDB-private/**)",
      "Read(../../YouthDB-private/**)",
      "Read(/Volumes/KIOXIA_2TB/YouthDB-private/**)",
      "Read(**/YouthDB-private/**)",
      "Read(**/お顔データ/**)",
      "Read(./.pgdata/**)",
      "Edit(./.audit/**)",
      "Write(./.audit/**)",
      "Edit(./.githooks/**)",
      "Write(./.githooks/**)",
      "Edit(./.github/workflows/audit.yml)",
      "Write(./.github/workflows/audit.yml)",
      "Edit(./basic/**)",
      "Write(./basic/**)",
      "Bash(git push:*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(rm -rf:*)",
      "Bash(pnpm deploy:production:*)",
      "Bash(pnpm db:migrate:production:*)",
      "Bash(pnpm db:restore:*)",
      "Bash(vercel:*)",
      "Edit(./.consultant/TOOL_PATH)",
      "Write(./.consultant/TOOL_PATH)",
      "Bash(git config core.hooksPath:*)",
      "Bash(npx vercel:*)",
      "Bash(node scripts/deploy-production.ts:*)",
      "Bash(node scripts/db-restore.ts:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(pnpm db:reset:*)",
      "Bash(pnpm import:*)",
      "Bash(pnpm ingest:*)",
      "Bash(pnpm demo:remove:*)"
    ]
  }
}
